{
  "manifest_version": 3,
  "name": "Quill Research",
  "version": "0.6.13",
  "description": "Save X reply opportunities locally, review individual replies, and export explicit profile or article captures.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://ai-gateway.vercel.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Quill for X"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "relevance.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "114"
}
